{
	"name": "gliese",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:tauri": "bun run story:check:strict && vite build --mode tauri && bun run story:assert-no-frontend-prose",
		"preview": "vite preview",
		"preview:village": "bun tools/preview-layered-region.ts",
		"art:controls:village": "bun tools/export-village-art-controls.ts",
		"art:controls:village-obstacles": "bun tools/export-sundrop-village-obstacle-controls.ts",
		"art:rasterize:village": "bun tools/rasterize-sundrop-village-art-control.ts",
		"art:normalize:village": "bun tools/normalize-sundrop-village-background.ts",
		"art:finalize:village": "bun tools/finalize-sundrop-village-background.ts",
		"art:finalize:village-obstacles": "bun tools/finalize-sundrop-village-obstacles.ts",
		"art:retouch:village": "bun tools/retouch-sundrop-village-background.ts",
		"art:evidence:village": "bun tools/refresh-sundrop-village-background-evidence.ts",
		"art:validate:village": "bun run test:unit -- --run src/lib/game/content/sundrop-village-background.asset.test.ts src/lib/game/content/maps/layered/village-art-controls.test.ts src/lib/game/content/backgrounds/sundrop-village-png.test.ts src/lib/game/content/backgrounds/sundrop-village-retouch.test.ts src/lib/game/content/backgrounds/sundrop-village-obstacle-ownership.test.ts src/lib/game/content/backgrounds/sundrop-village-obstacle-controls.test.ts src/lib/game/content/backgrounds/sundrop-village-obstacle-composite.test.ts src/lib/game/content/sundrop-village-obstacle-assets.test.ts",
		"prepare": "playwright install || echo '' && husky",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"story:check": "cargo run --manifest-path src-tauri/Cargo.toml --bin story_check -- --mode=draft --write-report --write-generated",
		"story:check:strict": "cargo run --manifest-path src-tauri/Cargo.toml --bin story_check -- --mode=strict --check-generated",
		"story:assert-no-frontend-prose": "bun tools/assert-no-frontend-story-prose.ts",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@tauri-apps/cli": "^2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.3",
		"@vitest/coverage-v8": "^4.1.6",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "14",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"sharp": "0.35.3",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	},
	"dependencies": {
		"@fontsource/cinzel": "^5.2.8",
		"@fontsource/spectral": "^5.2.8",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-fs": "^2",
		"phaser": "^4.0.0"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*": "prettier --write --ignore-unknown"
	}
}
