{
	"name": "gliese",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:tauri": "bun run story:check:strict && vite build --mode tauri && bun run story:assert-no-frontend-prose",
		"preview": "vite preview",
		"preview:village": "bun tools/preview-layered-region.ts",
		"art:controls:meadow-entry": "bun tools/export-meadow-entry-art-controls.ts",
		"art:approve:meadow-entry-controls": "bun tools/approve-meadow-entry-controls.ts",
		"art:export:meadow-entry": "bun tools/export-meadow-entry-regions.ts",
		"art:check:meadow-entry-export": "bun tools/export-meadow-entry-regions.ts --check",
		"art:proof:meadow-entry": "bun tools/render-meadow-entry-art-proofs.ts",
		"art:check:meadow-entry-proof": "bun tools/render-meadow-entry-art-proofs.ts --check",
		"art:approve:meadow-entry": "bun tools/approve-meadow-entry-art-package.ts",
		"art:check:meadow-entry-approval": "bun tools/approve-meadow-entry-art-package.ts --check",
		"art:validate:meadow-entry": "bun tools/validate-meadow-entry-art-package.ts",
		"world:probe:meadow-entry-textures": "bun tools/probe-meadow-entry-texture-safety.ts",
		"world:generate:meadow-entry-runtime": "bun tools/generate-meadow-entry-runtime.ts",
		"art:validate:meadow-entry-controls": "bun run art:storage:meadow-entry && bun tools/export-meadow-entry-art-controls.ts --check && bun tools/run-meadow-entry-controls-tests.ts",
		"art:storage:meadow-entry": "bun tools/verify-meadow-entry-art-storage.ts",
		"prepare": "playwright install || echo '' && husky",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "bun run build && playwright test",
		"story:check": "bun tools/export-story-content-references.ts && cargo run --manifest-path src-tauri/Cargo.toml --bin story_check -- --mode=draft --write-report --write-generated",
		"story:check:strict": "bun tools/export-story-content-references.ts --check && cargo run --manifest-path src-tauri/Cargo.toml --bin story_check -- --mode=strict --check-generated",
		"story:assert-no-frontend-prose": "bun tools/assert-no-frontend-story-prose.ts",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@tauri-apps/cli": "^2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.3",
		"@vitest/coverage-v8": "^4.1.6",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "14",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"sharp": "0.35.3",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	},
	"dependencies": {
		"@fontsource/cinzel": "^5.2.8",
		"@fontsource/spectral": "^5.2.8",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-fs": "^2",
		"phaser": "^4.0.0"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*": "prettier --write --ignore-unknown"
	}
}
